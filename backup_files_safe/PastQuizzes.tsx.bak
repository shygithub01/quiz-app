import React, { useState, useEffect } from 'react'
import { useAuth } from '@clerk/clerk-react'
import { format } from 'date-fns'
import { Button } from '@/components/ui/button'
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card'
import { AlertDialog, AlertDialogAction, AlertDialogCancel, AlertDialogContent, AlertDialogDescription, AlertDialogFooter, AlertDialogHeader, AlertDialogTitle, AlertDialogTrigger } from '@/components/ui/alert-dialog'
import { FileText, Trophy, Calendar, RotateCcw, Trash2, BookOpen, AlertCircle, MessageSquare } from 'lucide-react'
import { useToast } from '@/hooks/use-toast'

interface QuizHistoryEntry {
  id: string;
  title: string;
  type: 'document' | 'topic';
  settings: {
    difficulty: string;
    quizType: string;
    numQuestions: number;
  };
  createdAt: string;
  lastUpdated: string;
  questionCount: number;
  score?: number | null;
  completedAt?: string | null;
  hasBeenTaken?: boolean;
}

const API_BASE_URL = 'http://localhost:3001';

export default function PastQuizzes() {
  const { isSignedIn } = useAuth()
  const { toast } = useToast()
  const [quizzes, setQuizzes] = useState<QuizHistoryEntry[]>([])
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState('')
  const [deletingQuiz, setDeletingQuiz] = useState<string | null>(null)

  useEffect(() => {
    if (isSignedIn) {
      fetchQuizHistory()
    }
  }, [isSignedIn])

  const fetchQuizHistory = async () => {
    try {
      setLoading(true)
      setError('')
      
      const response = await fetch(`${API_BASE_URL}/api/quiz-history`)
      
      if (!response.ok) {
        throw new Error('Failed to fetch quiz history')
      }
      
      const data = await response.json()
      console.log('📊 Quiz history loaded:', data)
      setQuizzes(Array.isArray(data) ? data : [])
    } catch (err) {
      console.error('❌ Error fetching quiz history:', err)
      setError(err instanceof Error ? err.message : 'Failed to load quiz history')
    } finally {
      setLoading(false)
    }
  }

  const handleRetake = async (quizId: string) => {
    window.location.href = `/?retake=${encodeURIComponent(quizId)}`
  }

  const handleDelete = async (quizId: string) => {
    setDeletingQuiz(quizId)
    try {
      const response = await fetch(`${API_BASE_URL}/api/quiz-history/${encodeURIComponent(quizId)}`, {
        method: 'DELETE'
      })
      
      if (!response.ok) {
        throw new Error('Failed to delete quiz')
      }
      
      setQuizzes(prev => prev.filter(q => q.id !== quizId))
      toast({
        title: "Quiz Deleted",
        description: "Quiz has been removed from your history.",
      })
    } catch (err) {
      console.error('❌ Error deleting quiz:', err)
      setError(err instanceof Error ? err.message : 'Failed to delete quiz')
      toast({
        title: "Error",
        description: "Failed to delete quiz. Please try again.",
        variant: "destructive",
      })
    } finally {
      setDeletingQuiz(null)
    }
  }

  const formatQuizTitle = (quiz: QuizHistoryEntry) => {
    if (quiz.type === 'topic') {
      return `${quiz.title} (${quiz.settings?.difficulty || 'medium'}, ${quiz.settings?.numQuestions || 5}Q)`
    }
    return quiz.title
  }

  const getQuizIcon = (type: string) => {
    return type === 'topic' ? MessageSquare : FileText
  }

  const formatScore = (quiz: QuizHistoryEntry) => {
    if (quiz.score !== null && quiz.score !== undefined && quiz.questionCount) {
      const percentage = Math.round((quiz.score / quiz.questionCount) * 100)
      return {
        text: `${quiz.score}/${quiz.questionCount}`,
        percentage,
        color: percentage >= 80 ? 'text-green-600' : percentage >= 60 ? 'text-yellow-600' : 'text-red-600'
      }
    }
    return null
  }

  if (!isSignedIn) {
    return (
      <div className="w-full max-w-2xl animate-fade-in">
        <Card className="bg-card/50 backdrop-blur-sm border-0 shadow-2xl">
          <CardHeader className="text-center">
            <CardTitle className="text-2xl font-bold text-foreground flex items-center justify-center gap-2">
              <AlertCircle className="w-6 h-6 text-primary" />
              Sign In Required
            </CardTitle>
          </CardHeader>
          <CardContent className="text-center">
            <p className="text-muted-foreground">
              Please sign in to view your quiz history.
            </p>
          </CardContent>
        </Card>
      </div>
    )
  }

  if (loading) {
    return (
      <div className="flex flex-col items-center justify-center min-h-[60vh] animate-fade-in">
        <div className="w-8 h-8 border-4 border-primary/30 border-t-primary rounded-full animate-spin mb-4"></div>
        <p className="text-muted-foreground text-lg">Loading quiz history...</p>
      </div>
    )
  }

  return (
    <div className="w-full max-w-4xl animate-fade-in">
      <Card className="bg-card/50 backdrop-blur-sm border-0 shadow-2xl">
        <CardHeader className="text-center">
          <CardTitle className="text-3xl font-bold text-foreground flex items-center justify-center gap-3 mb-2">
            <BookOpen className="w-8 h-8 text-primary animate-bounce-gentle" />
            Past Quizzes
          </CardTitle>
          <p className="text-muted-foreground">
            Review your quiz history and retake previous quizzes
          </p>
        </CardHeader>

        <CardContent>
          {error && (
            <div className="mb-6 flex items-center gap-3 bg-destructive/10 text-destructive p-4 rounded-lg border border-destructive/20">
              <AlertCircle className="w-5 h-5 flex-shrink-0" />
              <span>{error}</span>
            </div>
          )}

          {quizzes.length === 0 ? (
            <div className="text-center py-12">
              <div className="w-24 h-24 mx-auto mb-6 text-muted-foreground/50">
                <BookOpen className="w-full h-full" />
              </div>
              <h3 className="text-xl font-semibold text-foreground mb-2">
                No quizzes yet
              </h3>
              <p className="text-muted-foreground mb-6">
                Take your first quiz to see it appear here.
              </p>
              <Button asChild variant="gradient" size="lg">
                <a href="/">
                  <FileText className="w-5 h-5" />
                  Create Your First Quiz
                </a>
              </Button>
            </div>
          ) : (
            <div className="grid gap-4">
              {quizzes.map((quiz) => {
                const QuizIcon = getQuizIcon(quiz.type)
                const scoreInfo = formatScore(quiz)
                
                return (
                  <Card
                    key={quiz.id}
                    className="border border-border hover:border-primary/50 hover:shadow-lg transition-all duration-300 hover:-translate-y-1"
                  >
                    <CardContent className="p-6">
                      <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                        <div className="flex-1 space-y-3">
                          <div className="flex items-start gap-3">
                            <QuizIcon className="w-5 h-5 text-primary flex-shrink-0 mt-1" />
                            <div className="flex-1 min-w-0">
                              <h3 className="text-lg font-semibold text-foreground truncate">
                                {formatQuizTitle(quiz)}
                              </h3>
                              <div className="flex gap-2 flex-wrap">
                                <div className="inline-flex items-center px-2 py-1 bg-accent/50 text-accent-foreground rounded text-xs font-medium uppercase tracking-wider">
                                  {quiz.type}
                                </div>
                                <div className="inline-flex items-center px-2 py-1 bg-primary/10 text-primary rounded text-xs font-medium">
                                  {quiz.settings.difficulty}
                                </div>
                                <div className="inline-flex items-center px-2 py-1 bg-secondary text-secondary-foreground rounded text-xs font-medium">
                                  {quiz.questionCount} questions
                                </div>
                                
                                {scoreInfo && (
                                  <div className={`inline-flex items-center px-3 py-1 bg-white border rounded text-xs font-bold ${scoreInfo.color}`}>
                                    <Trophy className="w-3 h-3 mr-1" />
                                    Score: {scoreInfo.text} ({scoreInfo.percentage}%)
                                  </div>
                                )}
                                
                                {quiz.hasBeenTaken ? (
                                  <div className="inline-flex items-center px-2 py-1 bg-green-100 text-green-800 rounded text-xs font-medium">
                                    ✅ Completed
                                  </div>
                                ) : (
                                  <div className="inline-flex items-center px-2 py-1 bg-gray-100 text-gray-600 rounded text-xs font-medium">
                                    📝 Not Taken
                                  </div>
                                )}
                              </div>
                            </div>
                          </div>
                          
                          <div className="flex flex-wrap items-center gap-4 text-sm text-muted-foreground">
                            <div className="flex items-center gap-2">
                              <Calendar className="w-4 h-4" />
                              <span>Created: {format(new Date(quiz.createdAt), 'MMM dd, yyyy')}</span>
                            </div>
                            {quiz.lastUpdated !== quiz.createdAt && (
                              <div className="flex items-center gap-2">
                                <RotateCcw className="w-4 h-4" />
                                <span>Updated: {format(new Date(quiz.lastUpdated), 'MMM dd, yyyy')}</span>
                              </div>
                            )}
                            {quiz.completedAt && (
                              <div className="flex items-center gap-2">
                                <Trophy className="w-4 h-4" />
                                <span>Completed: {format(new Date(quiz.completedAt), 'MMM dd, yyyy')}</span>
                              </div>
                            )}
                          </div>
                        </div>
                        
                        <div className="flex gap-2 flex-shrink-0">
                          <Button
                            onClick={() => handleRetake(quiz.id)}
                            variant="default"
                            size="sm"
                            className="min-w-[100px]"
                          >
                            <RotateCcw className="w-4 h-4" />
                            {quiz.hasBeenTaken ? 'Retake' : 'Start'}
                          </Button>
                          
                          <AlertDialog>
                            <AlertDialogTrigger asChild>
                              <Button
                                variant="destructive"
                                size="sm"
                                disabled={deletingQuiz === quiz.id}
                                className="min-w-[100px]"
                              >
                                {deletingQuiz === quiz.id ? (
                                  <>
                                    <div className="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin" />
                                    Deleting...
                                  </>
                                ) : (
                                  <>
                                    <Trash2 className="w-4 h-4" />
                                    Delete
                                  </>
                                )}
                              </Button>
                            </AlertDialogTrigger>
                            <AlertDialogContent>
                              <AlertDialogHeader>
                                <AlertDialogTitle>Delete Quiz?</AlertDialogTitle>
                                <AlertDialogDescription>
                                  Are you sure you want to delete this quiz? 
                                  This action cannot be undone and will remove your score history.
                                </AlertDialogDescription>
                              </AlertDialogHeader>
                              <AlertDialogFooter>
                                <AlertDialogCancel>Cancel</AlertDialogCancel>
                                <AlertDialogAction
                                  onClick={() => handleDelete(quiz.id)}
                                  className="bg-destructive text-destructive-foreground hover:bg-destructive/90"
                                >
                                  Delete
                                </AlertDialogAction>
                              </AlertDialogFooter>
                            </AlertDialogContent>
                          </AlertDialog>
                        </div>
                      </div>
                    </CardContent>
                  </Card>
                )
              })}
            </div>
          )}
        </CardContent>
      </Card>
    </div>
  )
}
