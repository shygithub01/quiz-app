import React from 'react'
import { Outlet, Link, useLocation } from 'react-router-dom'
import { useAuth, useUser, SignInButton, SignOutButton } from '@clerk/clerk-react'
import { Button } from '@/components/ui/button'
import { Brain, BookOpen, LogOut } from 'lucide-react'

export default function Layout() {
  const { isSignedIn, isLoaded } = useAuth()
  const { user } = useUser()
  const location = useLocation()

  return (
    <div className="min-h-screen bg-gradient-to-br from-blue-500 via-purple-600 to-purple-800">
      {/* Header */}
      <header className="bg-white/10 backdrop-blur-md border-b border-white/20 sticky top-0 z-50">
        <div className="container mx-auto px-4 py-4">
          <div className="flex items-center justify-between gap-4 flex-wrap">
            {/* Logo and Title */}
            <Link to="/" className="flex items-center gap-3 group">
              <Brain className="w-8 h-8 text-white group-hover:animate-bounce-gentle transition-all" />
              <div className="flex flex-col">
                <h1 className="text-2xl md:text-3xl font-bold text-white leading-tight">
                  AI Quiz Generator
                </h1>
                <span className="text-sm text-white/80 hidden md:block">
                  Transform your documents into interactive quizzes
                </span>
              </div>
            </Link>

            {/* Navigation and User Section */}
            <div className="flex items-center gap-4">
              {/* Navigation Links */}
              {isSignedIn && (
                <nav className="flex gap-2">
                  <Button
                    asChild
                    variant={location.pathname === '/' ? 'default' : 'ghost'}
                    size="sm"
                    className={location.pathname !== '/' ? 'text-white hover:bg-white/20' : ''}
                  >
                    <Link to="/">
                      <Brain className="w-4 h-4" />
                      <span className="hidden sm:inline">Quiz</span>
                    </Link>
                  </Button>
                  <Button
                    asChild
                    variant={location.pathname === '/past-quizzes' ? 'default' : 'ghost'}
                    size="sm"
                    className={location.pathname !== '/past-quizzes' ? 'text-white hover:bg-white/20' : ''}
                  >
                    <Link to="/past-quizzes">
                      <BookOpen className="w-4 h-4" />
                      <span className="hidden sm:inline">History</span>
                    </Link>
                  </Button>
                </nav>
              )}

              {/* User Section */}
              {isLoaded && (
                <div className="flex items-center gap-3">
                  {isSignedIn ? (
                    <>
                      {/* User Info */}
                      <div className="hidden md:flex flex-col items-end">
                        <span className="text-sm font-medium text-white truncate max-w-[120px]">
                          {user?.firstName || user?.emailAddresses[0]?.emailAddress}
                        </span>
                        <span className="text-xs text-white/70">
                          Signed in
                        </span>
                      </div>
                      
                      {/* Sign Out Button */}
                      <SignOutButton>
<Button variant="outline" size="sm" className="border-white/50 text-white hover:bg-white/10 hover:text-white bg-transparent text-white">
                          <LogOut className="w-4 h-4" />
                          <span className="hidden sm:inline">Sign Out</span>
                        </Button>
                      </SignOutButton>
                    </>
                  ) : (
                    <SignInButton mode="modal">
                      <Button variant="default" size="sm">
                        <Brain className="w-4 h-4" />
                        Sign In
                      </Button>
                    </SignInButton>
                  )}
                </div>
              )}
            </div>
          </div>
        </div>
      </header>

      {/* Main Content */}
      <main className="container mx-auto px-4 py-8 flex flex-col items-center min-h-[calc(100vh-80px)]">
        <Outlet />
      </main>
    </div>
  )
}
