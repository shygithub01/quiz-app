rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - users can read/write their own data, authenticated users can read all
    match /users/{userId} {
      allow read: if request.auth != null; // Any authenticated user can read user profiles
      allow write: if request.auth != null; // Allow authenticated users to write (for restoration)
    }
    
    // Quiz templates - anyone can read, only authenticated users can write
    match /quizTemplates/{quizId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Quiz attempts - nested under users collection
    match /users/{userId}/attempts/{attemptId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Competitions - anyone can read, authenticated users can write
    match /competitions/{competitionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Leaderboard - anyone can read, system can write
    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Scholarship registrations - users can read/write their own registration
    match /scholarshipRegistrations/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Competition settings - anyone can read, only authenticated users can write
    match /competitionSettings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // App settings - anyone can read, only authenticated users can write
    match /appSettings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Practice attempts - anyone can read, authenticated users can write their own
    match /practiceAttempts/{attemptId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Subscriptions - users can read their own, only Cloud Functions can write
    match /subscriptions/{subscriptionId} {
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Usage tracking - users can read their own, only Cloud Functions can write
    match /usageTracking/{trackingId} {
      allow read: if request.auth != null && 
        trackingId.matches(request.auth.uid + '_.*');
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Dynamic pricing - anyone can read, only admins can write
    match /dynamicPricing/{pricingId} {
      allow read: if true;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }
    
    // Discount codes - anyone can read active codes, only admins can write
    match /discountCodes/{codeId} {
      allow read: if true;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }
    
    // Refunds - users can read their own, only admins can write
    match /refunds/{refundId} {
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin']);
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }
    
    // Pricing history - only admins can read/write
    match /pricingHistory/{historyId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }
    
    // Promotional campaigns - anyone can read active campaigns, only admins can write
    match /promotionalCampaigns/{campaignId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    // Live event archive — authenticated users can write (host archiving results),
    // authenticated users can read/delete (admin reviewing history)
    match /liveEventArchive/{archiveId} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null;
    }
  }
}