          ".write": true
        }
      }
    },
    "eventAnswers": {
      ".read": true,
      "$eventId": {
        "$sessionId": {
          ".write": true
        }
      }
    },
    "eventAnswerCounts": {
      ".read": true,
      "$eventId": {
        ".write": true
      }
    },
    "eventLeaderboard": {
      ".read": true,
      "$eventId": {
        ".write": "auth != null"
      }
    },
    "practiceSessions": {
      ".read": true,
